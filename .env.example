# Copy to .env and fill in. Never commit the real .env.

# Database (Neon Postgres)
DATABASE_URL=

# Auth (better-auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments (Paystack) — see PAYMENT-SETUP.md
PAYSTACK_SECRET_KEY=

# Product images (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM="CHNW <orders@chnw.ng>"

# WhatsApp enquiries on made-to-order products, international format digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
CRON_SECRET=
CHECKOUT_RESERVATION_MINUTES=
